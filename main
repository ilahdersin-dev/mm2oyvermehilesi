local function makeCard(name, y)
    local card = make("Frame", {
        Name = name,
        Position = UDim2.fromOffset(0, y),
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = CONFIG.Surface,
        BorderSizePixel = 0,
    }, content)
    round(card, 11)
    stroke(card, Color3.fromRGB(39, 42, 52), 1)
    return card
end

