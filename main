-- Tek dosyalı istemci tarafı karakter kontrolü.
-- Sunucu tarafından reddedilirse gerçek yeniden doğma
-- için sunucu Script'i gerekir.

local function getCharacter()
    local character = player.Character
    if not character then return nil, nil end
    return character, character:FindFirstChildOfClass("Humanoid")
end

local function killCurrentCharacter()
    local character, humanoid = getCharacter()
    if not character or not humanoid then return end
    if humanoid.Health <= 0 then return end

    humanoid.Health = 0
end

local function updateToggle()
    local color = loopEnabled and CONFIG.Accent
        or Color3.fromRGB(52, 54, 64)

    local position = loopEnabled
        and UDim2.new(1, -24, 0, 3)
        or UDim2.fromOffset(3, 3)

    tween(toggle, 0.16, {BackgroundColor3 = color})
    tween(knob, 0.16, {Position = position})

    status.Text = loopEnabled
        and "SÜREKLİ DOĞMA AÇIK"
        or "SÜREKLİ DOĞMA KAPALI"

    status.TextColor3 = loopEnabled and CONFIG.Green or CONFIG.Muted
    statusDot.BackgroundColor3 = loopEnabled and CONFIG.Green or CONFIG.Muted
    loopIcon.BackgroundColor3 = loopEnabled
        and Color3.fromRGB(25, 59, 45)
        or CONFIG.Surface2
    loopIconText.TextColor3 = loopEnabled and CONFIG.Green or CONFIG.Muted
end

local function onCharacterAdded(character)
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid then return end

        if humanoidConnection then
            humanoidConnection:Disconnect()
            humanoidConnection = nil
        end

        if loopEnabled and savedPosition then
            task.wait(0.1)
            if player.Character == character then
                pcall(function()
                    character:PivotTo(savedPosition)
                end)
            end
        end

        if loopEnabled then
            task.wait(CONFIG.RespawnDelay)
            if loopEnabled and player.Character == character
                and humanoid.Health > 0 then
                humanoid.Health = 0
            end
        end
    end)
end

characterConnection = player.CharacterAdded:Connect(onCharacterAdded)

-- Yeniden doğ butonu
respawnButton.Activated:Connect(function()
    playClick()
    tween(respawnButton, 0.08, {
        BackgroundColor3 = Color3.fromRGB(175, 24, 40)
    })
    task.delay(0.1, function()
        if respawnButton.Parent then
            tween(respawnButton, 0.15, {
                BackgroundColor3 = CONFIG.Accent
            })
        end
    end)
    killCurrentCharacter()
end)

-- Sürekli döngüyü aç / kapat
toggle.Activated:Connect(function()
    playClick()
    loopEnabled = not loopEnabled
    loopToken += 1

    if loopEnabled then
        local character = player.Character
        if character then
            savedPosition = character:GetPivot()
        end

        task.spawn(function()
            local myToken = loopToken

            -- Karakteri öldür; yeni karakter doğduğunda
            -- onCharacterAdded aynı işlemi tekrarlar.
            task.wait(0.1)
            if loopEnabled and loopToken == myToken then
                killCurrentCharacter()
            end
        end)
    else
        savedPosition = nil
    end

    updateToggle()
end)

-- Kapat / tekrar aç
