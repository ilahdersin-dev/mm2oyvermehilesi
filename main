local function tween(object, duration, properties, style)
    local info = TweenInfo.new(
        duration,
        style or Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )
    local t = TweenService:Create(object, info, properties)
    t:Play()
    return t
end

local function make(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function round(object, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, object)
end

local function stroke(object, color, thickness, transparency)
    return make("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, object)
end

local function label(parent, name, text, size, position, font, textSize, color)
    return make("TextLabel", {
        Name = name,
        BackgroundTransparency = 1,
        Size = size,
        Position = position,
        Text = text,
        Font = font or Enum.Font.Gotham,
        TextSize = textSize or 12,
        TextColor3 = color or CONFIG.White,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function playClick()
    local sound = make("Sound", {
        Name = "ZethClick",
        SoundId = CONFIG.ClickSound,
        Volume = 0.35,
    }, SoundService)

    sound:Play()
    task.delay(3, function()
        if sound.Parent then
            sound:Destroy()
        end
    end)
end

